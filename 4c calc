%token NUMBER
%left '+' '-'
%left '*' '/'

%%
S: E '\n' { printf("Result = %d \n", $1); }
 ;
E: E '+' E { $$ = $1 + $3; }
 | E '-' E { $$ = $1 - $3; }
 | E '*' E { $$ = $1 * $3; }
 | E '/' E { $$ = $1 / $3; }
 | '(' E ')' { $$ = $2; }
 | NUMBER { $$ = $1; }
 ;
