%{
#include <stdio.h>
%}
%%
int|float|char|if|else|while|for|return { printf("keyword \t\t %s\n", yytext); }
[0-9]+ { printf("constant \t\t %s\n", yytext); }
[a-zA-Z][a-zA-Z0-9]* { printf("Identifier \t\t %s\n", yytext); }
"//".* { printf("comment \t\t %s\n", yytext); }
"/*"([^*]|\*+[^/*])*\*+"/" { printf("Multiline Comment \t\t %s\n", yytext); }
[=+-*/<>!] { printf("operator \t\t %s\n", yytext); }
[()\{\};,] { printf("special symbol \t %s\n", yytext); }
[ \t\n]+ { /* ignore whitespace */ }
. { printf("Unknown \t\t %s\n", yytext); }
%%
int main() {
    printf("Enter c code (Ctrl+D to end):\n\n");
    yylex();
    return 0;
}
